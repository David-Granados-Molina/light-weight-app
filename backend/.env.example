DATABASE_URL="postgresql://usuario:contraseña@host:5432/nombre_db"
PORT=3000
CORS_ORIGIN="http://localhost:4200"
FRONTEND_URL="http://localhost:4200"

# Secreto para firmar los tokens de sesión (JWT). Cadena aleatoria larga;
# no la compartas ni la subas a un repositorio público.
JWT_SECRET=
# Duración de la sesión antes de tener que volver a iniciar sesión.
JWT_EXPIRES_IN=180d

# Email del usuario admin: ve la pantalla de "Amigos" en el perfil para consultar
# el historial y progreso del resto de usuarios.
ADMIN_EMAIL=

# Cuenta de demostración del botón "Acceder como test". Por defecto test@test.com.
TEST_USER_EMAIL=

# Envío del código de acceso vía Resend (HTTPS, no SMTP). Crea una cuenta gratis
# en https://resend.com y genera una API key. Sin esto el código no se envía: se
# escribe en el log del servidor con la marca [CODIGO-ACCESO], que sirve para
# desarrollar en local pero no para producción.
RESEND_API_KEY=

# Apaño mientras no haya un dominio propio verificado en Resend.
#
# El remitente de pruebas (onboarding@resend.dev) solo entrega al dueño de la
# cuenta de Resend, así que a los demás usuarios no les llegaría nada. Con esta
# variable puesta, TODOS los códigos van a esta dirección —con el email de quien
# lo pidió en el asunto— y se pasan a mano.
#
# En cuanto verifiques un dominio y cambies FROM_ADDRESS en src/lib/mailer.ts,
# borra esta variable: los códigos irán solos a su destinatario real.
LOGIN_CODE_RELAY_TO=
